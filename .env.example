# Скопируйте этот файл в .env и заполните значения.
# Список и значения по умолчанию — documents/overall/config.md.
# Файл .env не попадает в репозиторий.

# Модуль данных
TMDB_API_KEY=
CINEMATCH_DB_PATH=/data/cinematch.db

# API-слой
CINEMATCH_USER_ID=web:local

# Модуль агентов
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_CLASSIFIER_MODEL=
LLM_TIMEOUT_S=20
TURN_TIMEOUT_S=45

# Ожидание ответа агента в API-слое
AGENT_TIMEOUT_S=60
