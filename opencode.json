{
  "$schema": "https://opencode.ai/config.json",
  "model": "routerai/deepseek/deepseek-v4.1-flash-1017",
  "small_model": "routerai/deepseek/deepseek-v4.1-flash-1017",
  "instructions": [
    "documents/overall/contracts.md",
    "documents/overall/config.md",
    "documents/overall/build.md"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      ".env": "deny"
    },
    "bash": {
      "*": "ask",
      "uv *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "docker compose *": "allow",
      "docker ps*": "allow",
      "docker logs*": "allow",
      "curl -s localhost*": "allow",
      "curl -s http://localhost*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git switch*": "allow",
      "git checkout -b*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git stash*": "allow",
      "uv add *": "ask",
      "uv remove *": "ask",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "cat .env": "deny",
      "cat .env *": "deny"
    },
    "webfetch": "ask"
  },
  "autoupdate": "notify"
}
