@startuml
!include _style.iuml
title Компоненты модуля ИИ-агентов
component "API-слой\n(модуль интерфейса)" as API
package "Модуль ИИ-агентов" {
  component "Оркестратор\nhandle_user_turn" as O
  component "Классификатор\nзапросов" as IC
  component "Агент CineMatch" as A
  component "extract_context\n(агент как инструмент)" as EC
  component "Реестр инструментов" as TR
  component "Проверка ответа" as G
  component "Подключение к модели\n(Pydantic AI)" as L
  component "Промпты" as P
  component "Трасса решений" as TT
}
component "Модуль данных" as DATA
cloud "RouterAI" as RA
API --> O
O --> IC
O --> A
O --> G
O --> TT
A --> TR
TR --> EC
TR --> TT
IC --> L
A --> L
EC --> L
L ..> P
L --> RA : HTTPS
TR --> DATA : инструменты
O --> DATA : служебные\nфункции
@enduml
