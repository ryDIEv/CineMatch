@startuml
!include _style.iuml
title Выбор фильма и оценка при следующем визите
participant "API-слой" as API
participant "Оркестратор" as O
participant "Агент" as A
participant "RouterAI" as M
participant "Модуль данных" as D
API -> O : handle_user_turn("Выбираю «Двое и собака»", movie_id)
O -> M : классификатор запроса
M --> O : cinema
O -> A : сообщение + подсказка movie_id
A -> M : сообщение
M --> A : tool_use save_choice(movie_id)
A -> D : save_choice(user_id, movie_id)\n(фильм из последней подборки)
D --> A : ok
A -> M : результат
M --> A : AgentOutput(confirmation)
O --> API : AgentResponse(confirmation)
== Следующий визит ==
API -> O : handle_user_turn("/start")
O -> D : get_pending_feedback(user_id)
D --> O : «Двое и собака»
O -> A : указание: спросить оценку
A -> M : промпт + указание
M --> A : вопрос об оценке
O --> API : «Как вам фильм? На сколько из 10?»
API -> O : handle_user_turn("на восьмёрку")
O -> A : ответ
A -> M : ответ
M --> A : tool_use save_rating(movie_id, 8)
A -> D : save_rating(..., source = after_choice)
D --> A : ok, выбор закрыт
O --> API : «Записал: 8 из 10»
@enduml
