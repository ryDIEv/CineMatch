@startuml
!include _style.iuml
title Ход оркестратора: обработка одного сообщения
start
:handle_user_turn(user_id, message, movie_id);
:Загрузить настройки и сессию;
if (Длина сообщения > 1000?) then (да)
  :Ошибка INPUT_TOO_LONG;
  stop
endif
if (Согласие принято?) then (нет)
  :Правила хранения данных\n(модель не вызывается);
elseif (Город указан?) then (нет)
  :resolve_city → подтверждение города;
elseif (Этап confirm_delete?) then (да)
  :Классификатор: yes / no;
  if (yes?) then (да)
    :delete_user_data;
  else (нет)
    :Вернуться к диалогу;
  endif
else (этап dialog)
  :Классификатор запроса;
  switch (Класс)
  case (cinema)
    :Запуск агента\n(лимит 8 вызовов модели);
    :Проверка AgentOutput:\nсхема, фильмы из find_movies;
  case (delete_data)
    :Запрос подтверждения;
  case (off_topic, unsafe)
    :Вежливый отказ;
  endswitch
endif
:Сохранить сессию, записать трассу и события;
:Вернуть AgentResponse;
stop
@enduml
