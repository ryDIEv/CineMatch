@startuml
!include _style.iuml
title Жизненный цикл сессии диалога
[*] --> consent : первый визит
consent --> consent : отказ\n(данные не сохраняются)
consent --> onboarding : согласие принято
onboarding --> dialog : город подтверждён
dialog --> dialog : ход агента
dialog --> confirm_delete : классификатор:\ndelete_data
confirm_delete --> dialog : нет
confirm_delete --> [*] : да — данные удалены
dialog --> [*] : 24 часа без активности
@enduml
