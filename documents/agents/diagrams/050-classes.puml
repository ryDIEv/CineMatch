@startuml
!include _style.iuml
title Сущности модуля ИИ-агентов
hide empty methods
class "DialogSession\n(сессия диалога)" as S {
  user_id : str
  stage : Stage
  pending : PendingChoice [0..1]
  messages : list [0..20]
  last_shown_ids : list[int]
  shown_ids : list[int]
  clarifications_asked : int
  updated_at : datetime
}
class "EveningContext\n(контекст вечера)" as V {
  mood : Mood [0..1]
  energy : Level [0..1]
  available_minutes : int [0..1]
  company : Company [0..1]
  genre_wishes : list
  genre_avoid : list
  notes : str [0..1]
}
class "AgentOutput\n(ответ агента)" as O {
  kind : OutputKind
  text : str
  movie_ids : list[int] [0 или 3]
  reasons : list[str]
}
class "AgentTrace\n(трасса решений)" as T {
  step : str
  action : str
  summary : str
}
class "AgentResponse\n(ответ интерфейсу)" as AR {
  type : ResponseType
  text : str
  movies : list[MovieCard]
  trace : list[AgentTrace]
  stage : Stage
}
class "Choice\n(выбор)" as C {
  movie_id : int
  status : pending | rated | dismissed
}
class "WatchMark\n(оценка)" as W {
  movie_id : int
  rating : int [1..10]
  mood_match : MoodMatch [0..1]
  source : after_choice | manual
}
S "1" *-- "0..1" V : context
O ..> AR : проверяется и\nпреобразуется
AR "1" *-- "0..*" T
S ..> C : save_choice
S ..> W : save_rating
@enduml
