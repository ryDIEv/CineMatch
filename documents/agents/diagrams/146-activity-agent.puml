@startuml
!include _style.iuml
title Цикл агента CineMatch
start
:Системный промпт + история сессии\n+ указания оркестратора\n(неоценённый выбор, лимит вопросов);
repeat
  :Вызов модели;
  if (Модель запросила инструмент?) then (да)
    if (Инструмент в списке агента\nи аргументы корректны?) then (да)
      :Выполнить инструмент,\nдобавить шаг в трассу;
    else (нет)
      :Вернуть модели ошибку;
    endif
  else (нет — итоговый ответ)
    break
  endif
repeat while (Лимит вызовов не исчерпан?) is (да)
-> лимит исчерпан;
if (Ответ по схеме AgentOutput\nи фильмы из результатов поиска?) then (да)
  :Вернуть ответ оркестратору;
else (нет)
  :Один повтор с указанием ошибки;
  :При повторной ошибке — LLM_INVALID_OUTPUT;
endif
stop
@enduml
