@startuml
!include _style.iuml
title Удаление данных пользователя
participant "Оркестратор или\nAPI-слой" as O
participant "Фасад функций" as F
participant "Репозитории" as R
database "cinematch.db" as DB
O -> F : delete_user_data(user_id)
F -> R : delete_user(user_id)
R -> DB : BEGIN
R -> DB : DELETE FROM users WHERE user_id = ?
note right of DB
  ON DELETE CASCADE удаляет
  оценки, выборы и сессию
end note
R -> DB : COMMIT
R --> F : число удалённых записей по таблицам
F --> O : {deleted_counts}
@enduml
