@startuml
!include _style.iuml
title Загрузка каталога
actor "Сопровождающий" as OP
participant "Скрипт загрузки" as L
participant "Клиент TMDB" as T
participant "TMDB API" as API
participant "Репозитории" as R
database "cinematch.db" as DB
OP -> L : ingest_movies(pages, from_year, min_votes, resume)
L -> R : create_load(running)
L -> T : genres()
T -> API : GET genre/movie/list?language=ru-RU
API --> T : жанры
L -> R : upsert_genres
loop страницы 1..max_pages
  L -> T : discover(page)
  T -> API : GET discover/movie?page=N
  API --> T : 20 фильмов
  loop для каждого фильма
    T -> API : GET movie/{id}?append_to_response=credits,release_dates
    alt 429 Too Many Requests
      API --> T : 429 + Retry-After
      T -> T : пауза, повтор
    else 200
      API --> T : детали
    end
  end
  L -> R : транзакция UPSERT порции
  R -> DB : BEGIN … COMMIT
  L -> R : update_load(last_page = N)
end
L -> R : finish_load(completed)
L --> OP : отчёт: загружено, пропущено, время
@enduml
