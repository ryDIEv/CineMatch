@startuml
!include _style.iuml
title Проверка новинок по подпискам
participant "Планировщик отправки\n(бот)" as S
participant "Проверка новинок" as RC
participant "Клиент TMDB" as T
participant "Репозитории" as R
S -> RC : check_releases() раз в сутки
RC -> R : подписки, проверенные\nболее 24 ч назад
loop для каждого tmdb_id (без повторов)
  alt kind = series
    RC -> T : tv/{id}
    T --> RC : last_episode_to_air
  else kind = movie_release
    RC -> T : movie/{id}?append_to_response=release_dates
    T --> RC : дата выхода в РФ
  end
  alt появилась новинка (не равна last_seen)
    RC -> R : create_reminder(release, due_at = сейчас)\nдля всех подписчиков
    RC -> R : last_seen = новинка
  end
  RC -> R : last_checked_at = сейчас
end
S -> R : get_due_reminders()
R --> S : напоминания к отправке
@enduml
