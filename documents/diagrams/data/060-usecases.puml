@startuml
!include _style.iuml
left to right direction
title Варианты использования модуля данных
actor "Сопровождающий" as OP
actor "Модуль ИИ-агентов" as AG
actor "Планировщик\nотправки (бот)" as SCH
actor "Администратор" as ADM
rectangle "Модуль данных" {
  usecase "UC-12 Загрузить или\nобновить каталог" as UC12
  usecase "UC-13 Проверить новинки\nпо подпискам" as UC13
  usecase "Найти фильмы\nпо критериям" as F1
  usecase "Сохранить настройки,\nсогласие, оценку, выбор" as F2
  usecase "Хранить состояние\nсессии" as F3
  usecase "Получить погоду\nдля города" as F4
  usecase "Выдать напоминания,\nсрок которых наступил" as F5
  usecase "Удалить данные\nпользователя" as F6
  usecase "Рассчитать профиль\nпредпочтений" as F7
  usecase "Выдать статистику" as F8
}
OP --> UC12
SCH --> UC13
SCH --> F5
AG --> F1
AG --> F2
AG --> F3
AG --> F4
AG --> F6
AG --> F7
ADM --> F8
UC13 .> F5 : <<include>>
