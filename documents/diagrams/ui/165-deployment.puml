@startuml
!include _style.iuml
title Развёртывание модуля интерфейса
node "Компьютер разработчика" {
  artifact "cinematch-cli\n(консольное приложение)" as cli
}
node "Сервер (этап Telegram-бота)\nLinux" {
  node "systemd: cinematch-bot.service" {
    artifact "Процесс бота\n(aiogram, планировщик,\nмодули агентов и данных)" as bot
  }
  file ".env\n(TELEGRAM_BOT_TOKEN,\nTELEGRAM_ADMIN_IDS)" as env
}
cloud "Telegram Bot API\napi.telegram.org" as tg
note bottom of cli : модули агентов и данных\nработают в том же процессе
bot --> tg : HTTPS, long polling
bot ..> env
@enduml
