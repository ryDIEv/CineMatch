@startuml
!include _style.iuml
title Контекст модуля интерфейса
actor "Пользователь\nконсоли" as cu
actor "Пользователь\nTelegram" as tu
actor "Администратор" as adm
cloud "Telegram Bot API" as tg
component "Модуль интерфейса\n(консоль, бот,\nпланировщик отправки)" as ui #E8F0FE
component "Модуль ИИ-агентов" as ag
component "Модуль данных" as data
cu --> ui : ввод в терминале
tu --> tg : сообщения, кнопки
adm --> tg : команды
tg <--> ui : HTTPS\n(long polling)
ui --> ag : handle_user_turn()
ui --> data : напоминания к отправке,\nпроверка новинок,\nстатистика
@enduml
