@startuml
!include _style.iuml
title Нажатие кнопки-подсказки в Telegram
actor "Пользователь" as U
participant "Telegram" as TG
participant "BotHandlers" as H
participant "Модуль агентов" as AG
participant "TelegramRenderer" as R
U -> TG : нажимает «Смотрю первый»
TG -> H : callback_query(data = "opt:0")
H -> H : текст = reply_markup[0].text
H -> TG : answerCallbackQuery()
H -> TG : editMessageReplyMarkup(без кнопок)
H -> TG : sendChatAction(typing)
H -> AG : handle_user_turn(tg:id, telegram, "Смотрю первый")
AG --> H : AgentResponse(confirmation)
H -> R : render
R -> TG : sendMessage(текст)
TG --> U : «Отлично, приятного просмотра!»
@enduml
