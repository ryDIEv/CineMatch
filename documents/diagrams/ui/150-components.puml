@startuml
!include _style.iuml
title Компоненты модуля интерфейса
actor "Пользователь" as U
cloud "Telegram Bot API" as TG
package "Модуль интерфейса" {
  package "Консоль" {
    component "CliApp\n(цикл ввода, аргументы)" as CA
    component "CliRenderer\n(rich)" as CR
  }
  package "Telegram-бот" {
    component "Dispatcher\n(aiogram)" as DP
    component "BotHandlers\n(сообщения, кнопки,\nкоманды)" as BH
    component "TelegramRenderer\n(карточки, клавиатуры)" as TR
    component "AdminCommands" as AC
    component "ReminderDispatcher\n(планировщик отправки)" as RD
  }
  component "Config\n(.env)" as CF
}
component "Модуль ИИ-агентов" as AG
component "Модуль данных" as DATA
U --> CA
CA --> CR
CA --> AG : handle_user_turn
TG --> DP : обновления
DP --> BH
BH --> TR
BH --> AG : handle_user_turn
BH --> AC
AC --> DATA : get_admin_stats
RD --> DATA : get_due_reminders,\nmark_reminder_sent,\ncheck_releases
RD --> TR
TR --> TG : sendMessage
CA ..> CF
DP ..> CF
@enduml
