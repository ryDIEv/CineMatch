@startuml
!include _style.iuml
title Компоненты модуля ИИ-агентов
component "Модуль интерфейса" as UI
package "Модуль ИИ-агентов" {
  component "Оркестратор\nhandle_user_turn" as O
  component "Классификатор\nнамерений" as IC
  component "Защита диалога\n(валидация, ограничения)" as G
  component "Агент-распознаватель\nсостояния" as SA
  component "Агент-рекомендатель" as RA
  component "Агент-компаньон" as CA
  component "Агент-планировщик" as PA
  component "Реестр инструментов\n(схемы tool use)" as TR
  component "Клиент LLM" as L
  component "Хранилище промптов" as P
}
component "Модуль данных" as DATA
cloud "OpenRouter" as OR
UI --> O : handle_user_turn()
O --> IC
O --> G
O --> SA
O --> RA
O --> CA
O --> PA
IC --> L
SA --> L
RA --> L
CA --> L
PA --> L
SA --> TR
RA --> TR
CA --> TR
PA --> TR
L ..> P : загрузка\nпромптов
L --> OR : HTTPS
TR --> DATA : инструменты
O --> DATA : служебные\nфункции
@enduml
