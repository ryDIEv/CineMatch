@startuml
!include _style.iuml
title Жизненный цикл сессии диалога
[*] --> consent : первый запуск
consent --> onboarding : соглашение принято
consent --> [*] : отказ
onboarding --> idle : город и часовой\nпояс указаны
idle --> feedback : есть неоценённый фильм
idle --> collecting_state : намерение\n«подобрать фильм»
idle --> planning : намерение\n«напоминание / подписка»
idle --> feedback : намерение\n«я посмотрел X»
feedback --> idle : оценка сохранена
planning --> idle : напоминание создано\nили отклонено
collecting_state --> clarifying : базовые ответы
clarifying --> recommending : вектор состояния готов
recommending --> awaiting_reaction : три фильма показаны
awaiting_reaction --> recommending : another\n(другие варианты)
awaiting_reaction --> idle : select\n(фильм выбран)
awaiting_reaction --> idle : stop\n(подбор остановлен)
idle --> [*] : 24 часа без активности
@enduml
