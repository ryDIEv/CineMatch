@startuml
!include _style.iuml
title Подбор фильма с вызовом инструментов
participant "Интерфейс" as UI
participant "Оркестратор" as O
participant "Агент-распознаватель" as SA
participant "Агент-рекомендатель" as RA
participant "OpenRouter" as M
participant "Модуль данных" as D
UI -> O : handle_user_turn("подбери фильм")
O -> M : классификация намерения
M --> O : recommend
O -> SA : начать диалог
SA --> UI : базовые вопросы
UI -> O : ответы
O -> SA : ответы
SA -> M : промпт + ответы + инструменты
M --> SA : tool_use get_user_ratings, get_weather
SA -> D : get_user_ratings(), get_weather()
D --> SA : история, погода | None
SA -> M : результаты инструментов
M --> SA : уточняющий вопрос
SA --> UI : вопрос
UI -> O : ответ
O -> SA : ответ
SA -> M : ответ
M --> SA : вектор состояния (JSON)
SA --> O : вектор состояния
O -> RA : вектор состояния
RA -> M : промпт + вектор + инструменты
M --> RA : tool_use get_user_profile
RA -> D : get_user_profile()
D --> RA : профиль
RA -> M : профиль
M --> RA : tool_use find_movies(критерии)
RA -> D : find_movies(...)
D --> RA : кандидаты
alt кандидатов меньше трёх (не более 2 повторов)
  RA -> M : мало кандидатов
  M --> RA : tool_use find_movies(ослабленные критерии)
  RA -> D : find_movies(...)
  D --> RA : кандидаты
end
RA -> M : кандидаты
M --> RA : три фильма + обоснования (JSON)
RA --> O : рекомендации
O --> UI : AgentResponse(recommendations)
@enduml
