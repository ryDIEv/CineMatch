@startuml
!include _style.iuml
title Жизненный цикл напоминания
[*] --> scheduled : создано агентом
scheduled --> sent : наступило due_at,\nбот отправил сообщение
scheduled --> cancelled : пользователь отменил\nили удалил данные
sent --> done : пользователь ответил\n(оценка, переход к подбору)
sent --> expired : нет ответа 7 дней
done --> [*]
expired --> [*]
cancelled --> [*]
@enduml
