@startuml
!include _style.iuml
title Развёртывание
node "Компьютер разработчика" as dev {
  artifact "Консольное приложение\n(Python)" as cli
  database "SQLite\ndatabase.db" as db1
}
node "Сервер (арендуемый или университетский)\nэтап Telegram-бота" as srv {
  artifact "Процесс бота\n(aiogram + планировщик)" as bot
  artifact "Модуль ИИ-агентов\n(в процессе бота)" as ag
  database "SQLite\ndatabase.db" as db2
}
cloud "OpenRouter" as or
cloud "TMDB API" as tmdb
cloud "Open-Meteo" as om
cloud "Telegram Bot API" as tg
cli --> db1
cli --> or : HTTPS
cli --> tmdb : HTTPS\n(загрузка каталога)
cli --> om : HTTPS
bot --> ag
ag --> db2
ag --> or : HTTPS
ag --> om : HTTPS
bot --> tg : HTTPS\n(long polling)
@enduml
