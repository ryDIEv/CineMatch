@startuml
!include _style.iuml
title Сущности модуля ИИ-агентов
hide empty methods
class "DialogSession\n(сессия диалога)" as S {
  user_id : str
  stage : Stage
  updated_at : datetime
}
class "StateVector\n(вектор состояния)" as V {
  mood : Mood
  energy : Level
  available_minutes : int
  genre_wishes : list
  genre_avoid : list
  company : Company
  weather : Weather [0..1]
}
class "Recommendation\n(подборка)" as R {
  search_criteria : dict
  candidate_ids : list[int]
  cursor : int
  shown_ids : list[int]
}
class "Choice\n(выбранный фильм)" as C {
  movie_id : int
  chosen_at : datetime
  rated : bool
}
class "Reminder\n(напоминание)" as RM {
  id : int
  kind : ReminderKind
  due_at : datetime
  text : str
  status : ReminderStatus
}
class "WatchMark\n(отметка о просмотре)" as W {
  movie_id : int
  rating : int [1..10]
  mood_match : MoodMatch [0..1]
  source : rating_after_choice | manual
}
class "Subscription\n(подписка)" as SB {
  tmdb_id : int
  kind : series | movie_release
}
class "UserSettings\n(настройки)" as US {
  consent_at : datetime
  city : str
  timezone : str
}
US "1" -- "0..1" S
S "1" *-- "0..1" V
S "1" *-- "0..1" R
US "1" -- "0..*" C
C "1" -- "0..1" RM : напоминание\nоценить
US "1" -- "0..*" RM
US "1" -- "0..*" W
US "1" -- "0..*" SB
@enduml
