@startuml
!include _style.iuml
title Обработка реакции на подборку (агент-рекомендатель)
start
:Сообщение пользователя\n(текст или кнопка-подсказка);
:Классифицировать реакцию\n(LLM, ответ из перечня);
switch (Реакция)
case (select)
  :Определить номер или название\nвыбранного фильма;
  if (Однозначно?) then (да)
    :save_choice;
    if (Интерфейс — Telegram?) then (да)
      :create_reminder(rate_movie);
    endif
    :Подтвердить выбор;
  else (нет)
    :Уточнить, какой фильм;
  endif
case (another)
  if (Пожелание изменилось\n(«посмешнее», «покороче»)?) then (да)
    :Новые критерии,\nfind_movies с исключением показанных;
  elseif (В пуле есть ещё кандидаты?) then (да)
    :Следующие три из пула\nбез нового поиска;
  else (нет)
    :Ослабить критерии,\nfind_movies с исключением показанных;
  endif
  :Показать три фильма с обоснованием;
case (stop)
  :Завершить подбор,\nпредложить вернуться позже;
case (off_topic)
  :Вежливо вернуть к подборке;
endswitch
:Сохранить сессию;
stop
@enduml
