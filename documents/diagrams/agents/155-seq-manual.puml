@startuml
!include _style.iuml
title Самостоятельная отметка «я посмотрел X»
participant "Интерфейс" as UI
participant "Оркестратор" as O
participant "Агент-компаньон" as CA
participant "OpenRouter" as M
participant "Модуль данных" as D
UI -> O : «посмотрел Интерстеллар, на 9 из 10»
O -> M : классификация намерения
M --> O : watched
O -> CA : сообщение
CA -> M : промпт + сообщение + инструменты
M --> CA : tool_use search_movie("Интерстеллар")
CA -> D : search_movie(title)
D --> CA : найдено: 1 фильм
alt найдено несколько фильмов
  CA --> UI : «Какой именно?» + варианты
end
CA -> M : результат поиска
M --> CA : tool_use save_rating(movie_id, 9)
CA -> D : save_rating(...)
D --> CA : ok
CA -> M : ok
M --> CA : подтверждение
CA --> O : ответ
O --> UI : «Записал: Интерстеллар — 9/10»
@enduml
