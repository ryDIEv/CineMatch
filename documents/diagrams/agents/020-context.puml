@startuml
!include _style.iuml
title Контекст модуля ИИ-агентов
actor "Пользователь" as user
component "Модуль интерфейса\n(консоль, Telegram-бот,\nпланировщик отправки)" as ui
component "Модуль ИИ-агентов" as ag #E8F0FE
component "Модуль данных\n(SQLite, TMDB, Open-Meteo)" as data
cloud "OpenRouter\n(LLM API)" as llm
user --> ui : сообщения,\nкнопки
ui --> ag : handle_user_turn()
ag --> ui : AgentResponse
ag --> data : инструменты и\nслужебные функции
ag --> llm : запросы к модели\n(tool use)
ui --> data : выборка напоминаний\nк отправке
@enduml
