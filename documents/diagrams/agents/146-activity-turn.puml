@startuml
!include _style.iuml
title Ход оркестратора: обработка одного сообщения
start
:Получить сообщение\n(handle_user_turn);
:Проверка ввода: длина, пустое сообщение;
:Загрузить настройки и сессию;
if (Соглашение принято?) then (нет)
  :Этап consent;
elseif (Город и часовой пояс заданы?) then (нет)
  :Этап onboarding;
elseif (Сессия на этапе диалога?) then (да)
  :Передать агенту текущего этапа;
elseif (Запуск (/start) и есть\nнеоценённый фильм?) then (да)
  :Агент-компаньон:\nсистемное напоминание об оценке;
else (этап idle)
  :Классифицировать намерение\n(вызов LLM, ответ из перечня);
  switch (Намерение)
  case (подобрать фильм)
    :Агент-распознаватель;
  case (я посмотрел X)
    :Агент-компаньон;
  case (напоминание / подписка)
    :Агент-планировщик;
  case (удалить мои данные)
    :Подтверждение и удаление;
  case (не по теме)
    :Вежливый отказ;
  endswitch
endif
:Проверить ответ агента по JSON-схеме;
:Сохранить сессию;
:Вернуть AgentResponse;
stop
@enduml
