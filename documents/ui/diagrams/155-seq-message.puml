@startuml
!include _style.iuml
title Сообщение с потоковым ответом
actor "Пользователь" as U
participant "Веб-приложение" as W
participant "API-слой" as A
participant "Модуль агентов" as AG
U -> W : «устал, хочу на полтора часа»
W -> A : POST /api/v1/messages {text}
activate A
A -> AG : handle_user_turn(web:local, text)\nв рабочем потоке
A --> W : event: progress «Определяю настроение…»
A --> W : event: progress «Ищу фильмы…»
AG --> A : AgentResponse
A --> W : event: response {AgentResponse}
deactivate A
W --> U : текст, три карточки, «Как агент выбирал»
alt ошибка агентов или таймаут 60 с
  A --> W : event: error {code, message}
  W --> U : сообщение об ошибке, ввод доступен
end
@enduml
